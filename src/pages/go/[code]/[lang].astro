---
// Forwards to a store, for a visitor whose content blocker hid the store badge:
// the badge's fallback link (StoreBadge.astro) comes here, on the site itself,
// and this page sends the browser on to the store page the badge links to. Its
// heading is the badge's wording. The same blocker can hide a link to the store
// here too, so the page never links to the store. Its button goes straight to
// the store from a small script, reading the address from the forward above; the
// link itself names only this page, so blockers leave it, and without the script
// a tap reloads this page, which forwards again. A second link goes back to the
// download page. Both
// are part of the page, so they are there whenever Safari shows the tab again
// after the store opened. One per store on sale and language. Never indexed,
// and not in the sitemap (astro.config.mjs).
import type { GetStaticPaths } from "astro";
import { badgeWording, goPath, storeCode } from "../../../data/badges";
import { platforms, storeNames, storeUrl, type StoreId } from "../../../data/stores";
import { builtLanguages, fill, localePath, useStrings, type Language } from "../../../i18n";

export const getStaticPaths = (() =>
  platforms.flatMap((p) =>
    p.status === "available"
      ? builtLanguages.map((lang) => ({
          params: { code: storeCode(p.store), lang: lang.path },
          props: { lang, store: p.store, url: storeUrl(p.store, p.storeId, lang.hreflang), wording: badgeWording(p.store, lang.code) },
        }))
      : [],
  )) satisfies GetStaticPaths;

interface Props {
  lang: Language;
  store: StoreId;
  url: string;
  wording: { alt: string; own: boolean };
}
const { lang, store, url, wording } = Astro.props;
const { t } = useStrings(lang.code);
// The badge's wording is English where the language has no badge of its own
const headingLang = wording.own ? undefined : "en";
---

<!doctype html>
<html lang={lang.hreflang} dir={lang.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <meta http-equiv="refresh" content={`0; url=${url}`} />
    <title>{wording.alt}</title>
    <style>
      body {
        margin: 0;
        padding: 32px 16px;
        font: 700 18px/1.5 system-ui, sans-serif;
        background: #fff;
        color: #14171a;
      }
      h1 {
        margin: 0 0 8px;
        font-size: 22px;
        line-height: 1.3;
      }
      a {
        display: inline-flex;
        min-height: 44px;
        align-items: center;
        color: #09649c;
        text-underline-offset: 3px;
      }
      .open {
        padding: 0 20px;
        border-radius: 9999px;
        background: #09649c;
        color: #fff;
        text-decoration: none;
      }
      @media (prefers-color-scheme: dark) {
        body {
          background: #15202b;
          color: #fff;
        }
        a {
          color: #4cb5f5;
        }
        .open {
          background: #4cb5f5;
          color: #15202b;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <h1 lang={headingLang}>{wording.alt}</h1>
      <p><a class="open" href={goPath(store, lang.path)}>{fill(t("go.open"), { store: storeNames[store] })}</a></p>
      <p><a href={localePath(lang.code, "download/")}>{t("go.back")}</a></p>
    </main>
    <script is:inline>
      document.querySelector(".open").addEventListener("click", (event) => {
        const to = document.querySelector('meta[http-equiv="refresh"]')?.content.split("url=")[1];
        if (!to) return;
        event.preventDefault();
        location.href = to;
      });
    </script>
  </body>
</html>
