---
// The handoff page between the site and a store, for a visitor whose content
// blocker hid the store badge: the badge's fallback link (StoreBadge.astro)
// comes here, and the page forwards the browser to the store page the badge
// links to. One per store on sale and language. Never indexed, and not in the
// sitemap (astro.config.mjs).
//
// Two states, in one card on the night colour:
// - Opening (with JavaScript, from before the page is drawn): the app's name and
//   a progress bar while the page forwards.
// - Come back (Safari shows the tab again, the tab comes back into view, or the
//   store has not opened after a few seconds; and always without JavaScript):
//   the store badge as the way on, two reassurance lines and a way back.
//
// Blockers can hide anything that names a store, so nothing here does: the
// badge is the official artwork, unaltered, under a neutral name with an empty
// alt (its wording is screen-reader text), and it links to this page itself.
// A tap goes straight to the store (from the address in the forward); without
// the script it reloads this page, which forwards again. If the badge is not
// drawn, a plain "Open the App Store" button takes its place.
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import icon from "../../../assets/brand/app-icon.png";
import { badgeArt, badgeWording, goPath, secondArt, storeCode } from "../../../data/badges";
import { platformName, platforms, storeNames, storeUrl, type PlatformId, type StoreId } from "../../../data/stores";
import { builtLanguages, fill, localePath, useStrings, type Language } from "../../../i18n";

export const getStaticPaths = (() =>
  platforms.flatMap((p) =>
    p.status === "available"
      ? builtLanguages.map((lang) => ({
          params: { code: storeCode(p.store), lang: lang.path },
          props: { lang, platform: p.id, store: p.store, url: storeUrl(p.store, p.storeId, lang.hreflang) },
        }))
      : [],
  )) satisfies GetStaticPaths;

interface Props {
  lang: Language;
  platform: PlatformId;
  store: StoreId;
  url: string;
}
const { lang, platform, store, url } = Astro.props;
const { t } = useStrings(lang.code);
const { alt, own } = badgeWording(store, lang.code);
const { file, image } = badgeArt(store, lang.code);
const storeName = storeNames[store];
const self = goPath(store, lang.path);
// The badge's wording is English where the store has no badge in this language
const wordingLang = own ? undefined : "en";
const HEIGHT = 52;
const width = Math.round((image.width / image.height) * HEIGHT);
---

<!doctype html>
<html lang={lang.hreflang} dir={lang.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark" />
    <meta http-equiv="refresh" content={`0; url=${url}`} />
    <title>{t("button.getApp")}</title>
    <meta name="description" content={fill(t("go.tap"), { store: storeName })} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("opening");
        const drawn = (link) => {
          const img = link?.isConnected && link.querySelector("img");
          if (!img || (img.complete && img.naturalWidth === 0) || getComputedStyle(img).visibility === "hidden") return false;
          for (let e = img; e; e = e.parentElement) if (getComputedStyle(e).opacity === "0") return false;
          const box = img.getBoundingClientRect();
          return box.width > 0 && box.height > 0 && box.right + scrollX > 0 && box.bottom + scrollY > 0;
        };
        // The plain button takes the badge's place if the badge is not drawn
        const check = () => {
          if (root.classList.contains("opening")) return;
          const on = document.querySelector("[data-go=on]");
          const text = document.querySelector("[data-go=text]");
          if (text?.hidden && !drawn(on)) {
            on?.setAttribute("hidden", "");
            text.hidden = false;
          }
        };
        const comeBack = () => {
          root.classList.remove("opening");
          check();
          setTimeout(check, 1000);
        };
        addEventListener("pageshow", (event) => event.persisted && comeBack());
        document.addEventListener("visibilitychange", () => document.visibilityState === "visible" && comeBack());
        // The store has not opened: offer the way on and the way back anyway
        setTimeout(comeBack, 3000);
        document.addEventListener("DOMContentLoaded", () => {
          document.querySelector("[data-go=on] img")?.addEventListener("error", check);
          // A tap goes straight to the store, the surest way to open it
          const to = document.querySelector('meta[http-equiv="refresh"]')?.content.split("url=")[1];
          for (const link of document.querySelectorAll("[data-go=on], [data-go=text] a"))
            link.addEventListener("click", (event) => {
              if (!to) return;
              event.preventDefault();
              location.href = to;
            });
        });
      })();
    </script>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
      }
      /* Words are never split or hyphenated across lines (as global.css) */
      html {
        hyphens: manual;
        overflow-wrap: normal;
        word-break: normal;
      }
      .keep-word {
        white-space: nowrap;
      }
      :lang(ko),
      :lang(ja),
      :lang(zh) {
        word-break: keep-all;
      }
      body {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        padding: 24px 16px 0;
        background: #15202b;
        color: #fff;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          Ubuntu,
          "Helvetica Neue",
          sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: inherit;
      }
      :focus-visible {
        outline: 3px solid #1da1f2;
        outline-offset: 3px;
        border-radius: 6px;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
      .card {
        margin: auto auto 0;
        width: 100%;
        max-width: 26rem;
        display: grid;
        justify-items: center;
        gap: 20px;
        padding: 28px 20px 24px;
        border: 2px solid #38444d;
        border-radius: 24px;
        background: #1e2732;
        text-align: center;
      }
      .icon {
        border-radius: 22%;
      }
      /* Ink blue for dark backgrounds: 6.9:1 on the card */
      .label {
        margin-top: -6px;
        font-size: 16px;
        font-weight: 800;
        color: #4cb5f5;
      }
      h1 {
        margin-top: -12px;
        font-size: 26px;
        line-height: 1.2;
        font-weight: 900;
        letter-spacing: -0.02em;
        text-wrap: balance;
      }
      .line {
        font-size: 17px;
        line-height: 1.45;
        color: #cbd5e1;
      }
      .later {
        display: grid;
        justify-items: center;
        gap: 20px;
        width: 100%;
      }
      .way-on {
        display: block;
        padding: 4px;
      }
      .way-on img {
        display: block;
        height: 52px;
        width: auto;
      }
      .reassure {
        justify-self: start;
        list-style: none;
        padding: 0;
        display: grid;
        gap: 8px;
        text-align: start;
        font-size: 16px;
        font-weight: 700;
        color: #cbd5e1;
      }
      .reassure li {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      /* The app's tab colours */
      .dot {
        flex: none;
        width: 10px;
        height: 10px;
        border-radius: 9999px;
        background: var(--tone);
      }
      .green {
        --tone: #00ba7c;
      }
      .violet {
        --tone: #794bc4;
      }
      .pill {
        width: 100%;
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 10px 24px;
        border-radius: 9999px;
        font-size: 17px;
        font-weight: 800;
        text-decoration: none;
      }
      /* Near-black text on the brand blue: 6.4:1 */
      .pill.primary {
        background: #1da1f2;
        color: #14171a;
      }
      .pill.quiet {
        border: 2px solid #38444d;
        color: #fff;
      }
      .progress {
        display: none;
        position: relative;
        overflow: hidden;
        width: 100%;
        max-width: 14rem;
        height: 4px;
        border-radius: 9999px;
        background: #38444d;
      }
      .progress::after {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 40%;
        border-radius: inherit;
        background: linear-gradient(90deg, #1da1f2, #794bc4);
        animation: slide 1.4s ease-in-out infinite;
      }
      @keyframes slide {
        from {
          transform: translateX(-100%);
        }
        to {
          transform: translateX(250%);
        }
      }
      .opening .progress {
        display: block;
      }
      .opening .later {
        display: none;
      }
      [hidden] {
        display: none !important;
      }
      footer {
        margin-top: auto;
        padding: 24px 0 16px;
        display: flex;
        justify-content: center;
      }
      footer a {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 15px;
        font-weight: 800;
        text-decoration: none;
        color: #cbd5e1;
      }
      @media (prefers-reduced-motion: reduce) {
        .progress::after {
          animation: none;
          width: 100%;
          opacity: 0.6;
        }
      }
      /* Writing systems that letter-spacing harms (as global.css) */
      html:is(:lang(ja), :lang(zh), :lang(ko), :lang(th), :lang(hi)) * {
        letter-spacing: normal !important;
      }
      html:is(:lang(th), :lang(hi)) h1 {
        line-height: 1.35;
      }
    </style>
  </head>
  <body>
    <main class="card">
      <Image src={icon} width={64} height={64} densities={[1, 2]} alt="" class="icon" loading="eager" />
      <p class="label" data-go="label">{platformName(lang, platform)}</p>
      <h1>{t("button.getApp")}</h1>
      <div class="progress" data-go="progress" aria-hidden="true"></div>
      <div class="later">
        <p class="line" data-go="line">{fill(t("go.tap"), { store: storeName })}</p>
        <a class="way-on" href={self} data-go="on">
          <img src={secondArt(file)} width={width} height={HEIGHT} alt="" />
          <span class="sr-only"><span lang={wordingLang}>{alt}</span></span>
        </a>
        <p class="pill-row" data-go="text" hidden>
          <a class="pill primary" href={self}>{fill(t("go.open"), { store: storeName })}</a>
        </p>
        <ul class="reassure" data-go="reassure">
          <li class="green"><span class="dot"></span><span>{t("home.pricing.title")}</span></li>
          <li class="violet"><span class="dot"></span><span>{t("go.offline")}</span></li>
        </ul>
        <a class="pill quiet" href={localePath(lang.code, "download/")} data-go="back">{t("go.back")}</a>
      </div>
    </main>
    <footer>
      <a href={localePath(lang.code, "/")}>
        <Image src={icon} width={24} height={24} densities={[1, 2]} alt="" class="icon" loading="eager" />
        Doughnut Forge
      </a>
    </footer>
  </body>
</html>
