---
// The app's tabs as coloured rows: the tab name in its tab colour, then what it
// does. Used on the home page and, with more detail, on the features page. The
// security page uses rows without a title: there the name is the section heading.
export type ToneRow = {
  /** The app's own tab name, such as "Text", or a section heading */
  name: string;
  tone: "blue" | "orange" | "violet" | "pink" | "green";
  title?: string;
  text: string;
  /** Further paragraphs, shown under the text */
  more?: string[];
  /** A link at the end of the text, such as "See the roadmap" */
  link?: { href: string; label: string };
};
interface Props {
  rows: ToneRow[];
}
const { rows } = Astro.props;
---

<ul class="rows" role="list">
  {
    rows.map((r) => (
      <li class:list={["row", "ruled-row", `tone-${r.tone}`, { "ruled-row-late": !r.title }]}>
        <div class="ruled-row-head">{r.title ? <p class="row-name">{r.name}</p> : <h2 class="row-name">{r.name}</h2>}</div>
        <div>
          {r.title && <h3>{r.title}</h3>}
          <p>
            {r.text}
            {r.link && (
              <>
                {" "}
                <a href={r.link.href}>{r.link.label}</a>
              </>
            )}
          </p>
          {r.more?.map((m) => <p>{m}</p>)}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .rows {
    margin-top: 32px;
  }
  .rows:first-child {
    margin-top: 0;
  }
  h3 {
    --fs: 19px;
    font-weight: 800;
  }
  .row p:not(.row-name) {
    margin-top: 4px;
    font-size: 17px;
    line-height: 1.55;
    max-width: 38rem;
    color: #475569;
  }
  .row p:not(.row-name) + p {
    margin-top: 10px;
  }
  .row a {
    font-weight: 700;
    color: var(--ink-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (prefers-color-scheme: dark) {
    .row p:not(.row-name) {
      color: #cbd5e1;
    }
  }
</style>
