---
// A real iPad screenshot in the same simple frame as Phone, AVIF/WebP at the sizes needed.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Rendered width, used to pick image sizes */
  sizes: string;
}
const { src, alt, sizes } = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  widths={[360, 540, 720, 1080].filter((w) => w <= src.width)}
  sizes={sizes}
  formats={["avif", "webp"]}
  loading="lazy"
  class="tablet-shot"
/>

<style>
  :global(.tablet-shot) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4.5% / 3.4%;
    border: 3px solid #38444d;
    background: #000;
    box-shadow: 0 18px 36px rgb(0 0 0 / 0.35);
  }
</style>
