---
// Site header, the same on every page: the app's night colour, with every link
// visible on phones in a row under the logo, so nothing hides behind a menu button.
// The language menu sits beside the logo on phones and after the links from 768px.
import { site } from "../data/site";
import { localePath, useStrings, type Language } from "../i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Logo from "./Logo.astro";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const { t } = useStrings(lang.code);

const links = [
  { href: localePath(lang.code, "features/"), label: t("nav.features") },
  { href: localePath(lang.code, "pricing/"), label: t("nav.pricing") },
  { href: localePath(lang.code, "download/"), label: t("nav.download") },
  { href: localePath(lang.code, "support/"), label: t("nav.support") },
];
const current = Astro.url.pathname;
// Narrow side padding on phones so all four links fit one row; 44px tall to tap.
// Below 360px (iPhone Display Zoom gives 320px) the links drop to 14px with 2px
// padding, which fits every language on one row: Ukrainian, the longest, keeps 12px.
const linkClass =
  "flex min-h-11 items-center rounded-full px-1.5 text-[15px] max-[359px]:px-0.5 max-[359px]:text-[14px] font-bold text-slate-200 hover:bg-white/10 hover:text-white aria-[current=page]:text-white aria-[current=page]:underline aria-[current=page]:decoration-[#4cb5f5] aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8 sm:px-4";
---

<header class="bg-[#15202b] text-white">
  {/* Chrome, kept out of search snippets (data-nosnippet works on div, span and section) */}
  <div data-nosnippet class="relative mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-3 gap-y-1 px-4 pt-2.5 pb-1.5 sm:px-6 md:pb-2.5">
    <a href={localePath(lang.code)} class="flex min-h-11 items-center gap-2.5" aria-label={t("nav.home")}>
      <Logo />
      <span class="text-[18px] font-extrabold tracking-tight">{site.name}</span>
    </a>
    <nav aria-label={t("nav.label")} class="order-last basis-full md:order-none md:ms-auto md:basis-auto">
      <ul class="flex flex-wrap items-center justify-between md:justify-end md:gap-1" role="list">
        {
          links.map((l) => (
            <li>
              <a class={linkClass} href={l.href} aria-current={current === l.href ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LanguageSwitcher lang={lang} />
  </div>
</header>
