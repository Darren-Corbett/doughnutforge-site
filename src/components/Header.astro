---
// Site header, the same on every page: the app's night colour, with every link
// visible on phones in a row under the logo, so nothing hides behind a menu button.
import { site } from "../data/site";
import { localePath, useStrings, type Language } from "../i18n";
import Logo from "./Logo.astro";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const { t } = useStrings(lang.code);

// Phase 1: only the home page exists, so links go to its sections. Phase 2 points them at pages.
const links = [
  { href: localePath(lang.code, "#features"), label: t("nav.features") },
  { href: localePath(lang.code, "#pricing"), label: t("nav.pricing") },
  { href: localePath(lang.code, "#download"), label: t("nav.download") },
  { href: site.supportUrl, label: t("nav.support") },
];
// Narrow side padding on phones so all four links fit one row at 360px; 44px tall to tap.
const linkClass =
  "flex min-h-11 items-center rounded-full px-1.5 text-[15px] font-bold text-slate-200 hover:bg-white/10 hover:text-white sm:px-4";
---

<header class="bg-[#15202b] text-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-3 gap-y-1 px-4 pt-2.5 pb-1.5 sm:px-6 md:pb-2.5">
    <a href={localePath(lang.code)} class="flex min-h-11 items-center gap-2.5" aria-label={t("nav.home")}>
      <Logo />
      <span class="text-[18px] font-extrabold tracking-tight">{site.name}</span>
    </a>
    <nav aria-label={t("nav.label")} class="basis-full md:basis-auto">
      <ul class="flex flex-wrap items-center justify-between md:justify-end md:gap-1" role="list">
        {
          links.map((l) => (
            <li>
              <a class={linkClass} href={l.href}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
