---
// Site header. Two looks:
// - "default": on phones the links sit in a <details> menu (works without JavaScript).
// - "night": joins a dark hero; all links stay visible on phones in a row under the
//   logo, so nothing is hidden behind a menu button.
import { Menu } from "@lucide/astro";
import { site } from "../data/site";
import { localePath, useStrings, type Language } from "../i18n";
import Logo from "./Logo.astro";

interface Props {
  lang: Language;
  tone?: "default" | "night";
}
const { lang, tone = "default" } = Astro.props;
const { t } = useStrings(lang.code);

// Phase 1: only the home page exists, so links go to its sections. Phase 2 points them at pages.
const links = [
  { href: localePath(lang.code, "#features"), label: t("nav.features") },
  { href: localePath(lang.code, "#pricing"), label: t("nav.pricing") },
  { href: localePath(lang.code, "#download"), label: t("nav.download") },
  { href: site.supportUrl, label: t("nav.support") },
];
const linkClass =
  "flex min-h-11 items-center rounded-full px-4 text-[15px] font-bold text-slate-700 hover:bg-[#1DA1F2]/10 hover:text-ink-blue dark:text-slate-200";
const nightLinkClass =
  "flex min-h-11 items-center rounded-full px-1.5 text-[15px] font-bold text-slate-200 hover:bg-white/10 hover:text-white sm:px-4";
---

{
  tone === "night" ? (
    <header class="bg-[#15202b] text-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-3 gap-y-1 px-4 pt-2.5 pb-1.5 sm:px-6 md:pb-2.5">
        <a href={localePath(lang.code)} class="flex min-h-11 items-center gap-2.5" aria-label={t("nav.home")}>
          <Logo />
          <span class="text-[18px] font-extrabold tracking-tight">{site.name}</span>
        </a>
        <nav aria-label={t("nav.label")} class="basis-full md:basis-auto">
          <ul class="flex flex-wrap items-center justify-between md:justify-end md:gap-1" role="list">
            {links.map((l) => (
              <li>
                <a class={nightLinkClass} href={l.href}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
  ) : (
<header class="border-b-2 border-slate-200 bg-white/90 dark:border-forge-border-dark dark:bg-forge-surface-dark/90">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2.5 sm:px-6">
    <a href={localePath(lang.code)} class="flex min-h-11 items-center gap-2.5" aria-label={t("nav.home")}>
      <Logo />
      <span class="text-[18px] font-extrabold tracking-tight">{site.name}</span>
    </a>

    <nav aria-label={t("nav.label")} class="hidden md:block">
      <ul class="flex items-center gap-1" role="list">
        {links.map((l) => <li><a class={linkClass} href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <details class="group relative md:hidden">
      <summary
        class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-full border-2 border-slate-200 px-4 text-[15px] font-bold dark:border-forge-border-dark [&::-webkit-details-marker]:hidden"
      >
        <Menu size={20} aria-hidden="true" />
        {t("nav.menu")}
      </summary>
      <nav
        aria-label={t("nav.label")}
        class="absolute end-0 z-10 mt-2 w-64 max-w-[calc(100vw-2rem)] rounded-[20px] border-2 border-slate-200 bg-white p-2 shadow-xl shadow-slate-300/50 dark:border-forge-border-dark dark:bg-forge-surface-dark dark:shadow-black/40"
      >
        <ul role="list">
          {links.map((l) => <li><a class={linkClass} href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </details>
  </div>
</header>
  )
}
