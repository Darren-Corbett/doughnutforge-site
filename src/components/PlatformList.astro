---
// Every platform with its store badge, or plain "Coming soon" text when it is
// not out yet: never a badge or a link for a platform that is not available.
import { Laptop, Monitor, Smartphone, Terminal, TabletSmartphone } from "@lucide/astro";
import { platforms, type PlatformId } from "../data/stores";
import { useStrings, type Language } from "../i18n";
import Card from "./Card.astro";
import IconTile from "./IconTile.astro";
import StoreBadge from "./StoreBadge.astro";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const { t } = useStrings(lang.code);
const icons: Record<PlatformId, typeof Laptop> = {
  mac: Laptop,
  windows: Monitor,
  ios: TabletSmartphone,
  linux: Terminal,
  android: Smartphone,
};
---

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
  {
    platforms.map((p) => {
      const Icon = icons[p.id];
      return (
        <Card as="li" class="flex flex-col gap-2">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <IconTile color={p.status === "available" ? "blue" : "violet"}>
              <Icon size={22} stroke-width={2.4} aria-hidden="true" />
            </IconTile>
            <h3 class="text-[18px] leading-snug font-extrabold">{t(`platform.${p.id}`)}</h3>
          </div>
          {p.status === "available" ? (
            <div class="-m-3 mt-0">
              <StoreBadge store={p.store} storeId={p.storeId} lang={lang} />
            </div>
          ) : (
            <p class="text-ink-violet text-[13px] font-extrabold tracking-widest uppercase">{t("platform.coming")}</p>
          )}
        </Card>
      );
    })
  }
</ul>
