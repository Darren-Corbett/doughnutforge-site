---
// Store badges for the platforms on sale, and one plain sentence for those still
// coming: never a badge or a link for a platform that is not available.
import StoreBadge from "./StoreBadge.astro";
import VisitorFirst from "./VisitorFirst.astro";
import { platformName, platforms } from "../data/stores";
import { fill, listOf, useStrings, type Language } from "../i18n";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const { t } = useStrings(lang.code);
const available = platforms.filter((p) => p.status === "available");
const coming = platforms.filter((p) => p.status === "coming").map((p) => platformName(lang, p.id));
// "Android and Linux", joined by each language's own rules
const note = [coming.length ? fill(t("download.coming"), { platforms: listOf(lang, coming) }) : "", t("download.availability")]
  .join(" ")
  .trim();
---

<div class="-m-3 flex flex-wrap">
  {available.map((p) => (p.status === "available" ? <StoreBadge platform={p.id} store={p.store} storeId={p.storeId} lang={lang} /> : null))}
</div>
<VisitorFirst />
<p class="mt-4 max-w-[34rem] text-[17px] leading-relaxed">{note}</p>
