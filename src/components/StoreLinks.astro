---
// Store badges for the platforms on sale, each under its device's name as on the
// Download cards (so the App Store and Mac App Store badges cannot be mixed up),
// and one plain sentence for those still coming: never a badge or a link for a
// platform that is not available.
import StoreBadge from "./StoreBadge.astro";
import { platformName, platforms } from "../data/stores";
import { fill, listOf, useStrings, type Language } from "../i18n";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const { t } = useStrings(lang.code);
const available = platforms.filter((p) => p.status === "available");
const coming = platforms.filter((p) => p.status === "coming").map((p) => platformName(lang, p.id));
// "Android", or several joined by each language's own rules
const note = [coming.length ? fill(t("download.coming"), { platforms: listOf(lang, coming) }) : "", t("download.availability")]
  .join(" ")
  .trim();
---

<ul class="platform-row -m-3 flex flex-wrap" role="list" data-nosnippet>
  {
    available.map((p) =>
      p.status === "available" ? (
        <li>
          <p class="name">{platformName(lang, p.id)}</p>
          <StoreBadge platform={p.id} store={p.store} storeId={p.storeId} lang={lang} />
        </li>
      ) : null,
    )
  }
</ul>
<p class="mt-4 max-w-[34rem] text-[17px] leading-relaxed">{note}</p>

<style>
  /* Lined up with the badge image, which sits inside its link's 12px padding */
  .name {
    padding: 12px 12px 0;
    font-size: 17px;
    font-weight: 800;
    line-height: 1.3;
    color: #0f172a;
  }
  @media (prefers-color-scheme: dark) {
    .name {
      color: #fff;
    }
  }
</style>
