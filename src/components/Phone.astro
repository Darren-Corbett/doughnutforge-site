---
// A real iPhone screenshot in a simple phone frame, AVIF/WebP at the sizes needed.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Rendered width, used to pick image sizes */
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { src, alt, sizes, eager = false, class: className = "" } = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  widths={[200, 300, 400, 600, 900].filter((w) => w <= src.width)}
  sizes={sizes}
  formats={["avif", "webp"]}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : "auto"}
  class:list={["phone-shot", className]}
/>

<style>
  :global(.phone-shot) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 11% / 5.2%;
    border: 3px solid #38444d;
    background: #000;
    box-shadow: 0 18px 36px rgb(0 0 0 / 0.35);
  }
</style>
