---
// Questions and answers that open in place, with no script. The page builds the
// FAQPage structured data from the same items, so both always match.
export type FaqItem = { id: string; q: string; a: string };
interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details id={`faq-${item.id}`}>
        <summary>
          <h3>{item.q}</h3>
        </summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    margin-top: 28px;
    max-width: 46rem;
    border-bottom: 2px solid #e2e8f0;
  }
  details {
    border-top: 2px solid #e2e8f0;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  h3 {
    font-size: 19px;
    line-height: 1.3;
    font-weight: 800;
  }
  /* A plus that turns into a minus, in the brand blue */
  summary::after {
    content: "";
    flex: none;
    width: 14px;
    height: 14px;
    background:
      linear-gradient(var(--ink-blue), var(--ink-blue)) center / 14px 3px no-repeat,
      linear-gradient(var(--ink-blue), var(--ink-blue)) center / 3px 14px no-repeat;
  }
  details[open] summary::after {
    background: linear-gradient(var(--ink-blue), var(--ink-blue)) center / 14px 3px no-repeat;
  }
  p {
    padding-bottom: 20px;
    font-size: 17px;
    line-height: 1.6;
    max-width: 40rem;
    color: #334155;
  }
  @media (prefers-color-scheme: dark) {
    .faq,
    details {
      border-color: #38444d;
    }
    p {
      color: #cbd5e1;
    }
  }
</style>
