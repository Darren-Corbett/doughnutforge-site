---
// The app's card: thick border, large radius, soft shadow.
interface Props {
  as?: "div" | "li" | "article";
  class?: string;
}
const { as: Tag = "div", class: className = "" } = Astro.props;
---

<Tag
  class:list={[
    "rounded-[20px] border-2 border-slate-200 bg-white p-5 shadow-xl shadow-slate-300/50 md:rounded-[24px] md:p-6 dark:border-forge-border-dark dark:bg-forge-surface-dark dark:shadow-black/40",
    className,
  ]}
>
  <slot />
</Tag>
