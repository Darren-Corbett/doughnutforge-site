---
import Card from "./Card.astro";
import IconTile, { type TileColor } from "./IconTile.astro";

interface Props {
  color: TileColor;
  /** The app's own name for the feature, when it has one ("Secure Text"). */
  label?: string;
  title: string;
}
const { color, label, title } = Astro.props;
---

<Card as="li" class="flex flex-col gap-3">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <IconTile color={color}><slot name="icon" /></IconTile>
    {label && <span class="text-[12px] font-extrabold tracking-widest text-slate-600 uppercase dark:text-slate-400">{label}</span>}
  </div>
  <h3 class="text-[18px] leading-snug font-extrabold">{title}</h3>
  <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-300"><slot /></p>
</Card>
