---
// Moves the visitor's own platform to the front of the list just before this
// script, if it is on sale. It runs as the page is read, before it is drawn, so
// nothing moves on screen. Without it, or if it fails, everyone sees the fixed
// mobile-first order from src/data/stores.ts, which is also what search engines
// see. It only reorders: nothing is hidden, stored or sent.
---

<script is:inline>
  (() => {
    try {
      const list = document.currentScript.previousElementSibling;
      const ua = navigator.userAgent;
      // iPadOS asks for desktop pages and calls itself a Mac; only it has a touch screen
      const ipad = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1;
      // Android before the others: its user agent also says "Linux"
      const own =
        /iPhone|iPad|iPod/.test(ua) || ipad ? "ios" : /Android/.test(ua) ? "android" : /Macintosh/.test(ua) ? "mac" : /Windows/.test(ua) ? "windows" : "";
      if (own) list.prepend(...list.querySelectorAll(`:scope > [data-platform="${own}"]:not([data-coming])`));
    } catch {
      // The fixed order stays
    }
  })();
</script>
