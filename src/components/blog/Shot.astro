---
// A real app screenshot in a blog post, in the site's phone frame, with a caption.
import type { ImageMetadata } from "astro";
import Phone from "../Phone.astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
}
const { src, alt, caption } = Astro.props;
---

<figure class="shot">
  <div class="frame">
    <Phone src={src} alt={alt} sizes="240px" />
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .frame {
    width: min(240px, 70%);
    margin-inline: auto;
  }
  .shot figcaption {
    text-align: center;
  }
</style>
