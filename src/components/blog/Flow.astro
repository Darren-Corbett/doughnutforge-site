---
// A simple illustration for blog posts: a few steps, each an app icon with a short
// label, joined by arrows. The words are HTML, never part of an image, so a
// translated post only translates text. Steps stack on phones and sit in a row
// from 560px.
import type { AstroComponent } from "@lucide/astro";

type Tone = "blue" | "green" | "orange" | "violet" | "pink";
interface Props {
  /** What the illustration shows, in one sentence: shown below it and read by screen readers */
  caption: string;
  steps: { icon: AstroComponent; text: string; tone?: Tone }[];
}
const { caption, steps } = Astro.props;
---

<figure class="flow">
  <ol role="list">
    {
      steps.map(({ icon: Icon, text, tone = "blue" }) => (
        <li class={`tone-${tone}`}>
          <span class="icon" aria-hidden="true">
            <Icon size={26} stroke-width={2.4} />
          </span>
          <span class="text">{text}</span>
        </li>
      ))
    }
  </ol>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .flow ol {
    display: grid;
    gap: 28px;
    margin: 0;
    padding: 20px 16px;
    list-style: none;
    border-radius: 16px;
    background: #f5f8fa;
  }
  .flow li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.3;
    color: #0f172a;
  }
  .flow li + li {
    margin-top: 0;
  }
  /* The arrow to the next step: decorative, so it is drawn in CSS */
  .flow li:not(:last-child)::after {
    content: "";
    position: absolute;
    inset-inline-start: 23px;
    bottom: -22px;
    width: 2px;
    height: 16px;
    background: var(--tone);
  }
  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    border: 2px solid var(--tone);
    background: color-mix(in srgb, var(--tone) 20%, transparent);
    color: var(--ink);
  }
  @media (min-width: 560px) {
    .flow ol {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      gap: 20px;
      padding: 24px 20px;
    }
    .flow li {
      flex-direction: column;
      text-align: center;
    }
    .flow li:not(:last-child)::after {
      inset-inline-start: auto;
      inset-inline-end: -16px;
      top: 23px;
      bottom: auto;
      width: 12px;
      height: 2px;
    }
  }
  @media (prefers-color-scheme: dark) {
    .flow ol {
      background: #15202b;
    }
    .flow li {
      color: #fff;
    }
  }
</style>
