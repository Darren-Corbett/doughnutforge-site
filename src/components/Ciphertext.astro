---
// An illustration of encrypted text: random characters, not real Doughnut Forge
// output. Ciphertext is not language, so it is the one place lines may break
// anywhere.
const CIPHER =
  "";
interface Props {
  /** What a screen reader announces instead of the characters */
  label: string;
  length?: number;
  class?: string;
}
const { label, length = 220, class: className = "" } = Astro.props;
---

<p class:list={["cipher", className]} translate="no"><span class="sr-only">{label}</span><span aria-hidden="true">{CIPHER.slice(0, length)}</span></p>

<style>
  .cipher {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
    word-break: break-all;
    overflow-wrap: anywhere;
  }
</style>
