---
// The app's button style: brand tints with readable ink text, never white on
// brand blue (that is below 4.5:1).
interface Props {
  href: string;
  variant?: "primary" | "secondary";
}
const { href, variant = "primary" } = Astro.props;
const styles = {
  primary:
    "border-forge-blue bg-[#1DA1F2]/20 text-ink-blue hover:bg-[#1DA1F2]/30 shadow-glow dark:bg-[#1DA1F2]/20",
  secondary:
    "border-slate-300 bg-white text-slate-800 hover:border-forge-blue dark:border-forge-border-dark dark:bg-forge-surface-dark dark:text-white",
};
---

<a
  href={href}
  class:list={[
    "inline-flex min-h-12 items-center justify-center gap-2 rounded-full border-2 px-6 py-2.5 text-center text-[16px] leading-snug font-extrabold transition-colors",
    styles[variant],
  ]}
>
  <slot />
</a>
