---
interface Props {
  id?: string;
  title?: string;
  class?: string;
}
const { id, title, class: className = "" } = Astro.props;
const headingId = id && title ? `${id}-title` : undefined;
---

<section id={id} aria-labelledby={headingId} class:list={["mx-auto w-full max-w-6xl scroll-mt-20 px-4 py-12 sm:px-6 md:py-16", className]}>
  {
    title && (
      <h2 id={headingId} class="mb-6 text-[26px] leading-tight font-extrabold tracking-tight md:mb-8 md:text-[32px]">
        {title}
      </h2>
    )
  }
  <slot />
</section>
