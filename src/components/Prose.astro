---
// Long text (privacy policy, legal page, blog posts) on a white card with the
// app's 24px radius and 2px border, as the old privacy page had.
interface Props {
  class?: string;
  /** "always" by default. "wide": a page that is one long text, where on phones the
      card's edge and padding would cut lines short, so the card starts at 640px.
      "none": text inside another layout, such as a ruled row, with no card. */
  sheet?: "always" | "wide" | "none";
}
const { class: className = "", sheet = "always" } = Astro.props;
---

<div class:list={["prose", `sheet-${sheet}`, className]}>
  <slot />
</div>

<style>
  .prose {
    max-width: 42rem;
    background: #fff;
    border: 2px solid #e2e8f0;
    border-radius: 24px;
    padding: 24px 20px;
    font-size: 17px;
    line-height: 1.65;
    color: #334155;
  }
  .prose :global(h2) {
    margin: 32px 0 10px;
    --fs: 21px;
    line-height: 1.25;
    font-weight: 800;
    color: #0f172a;
  }
  .prose :global(h3) {
    margin: 24px 0 8px;
    --fs: 18px;
    font-weight: 800;
    color: #0f172a;
  }
  /* Section links land below the top of the screen, not under the browser's edge */
  .prose :global(h2[id]) {
    scroll-margin-top: 24px;
  }
  .prose :global(:is(h2, h3):first-child) {
    margin-top: 0;
  }
  .prose :global(:is(p, ul, ol) + p),
  .prose :global(:is(ul, ol, figure, blockquote)) {
    margin-top: 14px;
  }
  .prose :global(ul) {
    list-style: disc;
    padding-inline-start: 22px;
  }
  .prose :global(ol) {
    list-style: decimal;
    padding-inline-start: 22px;
  }
  .prose :global(li + li) {
    margin-top: 6px;
  }
  .prose :global(strong) {
    color: #1e293b;
  }
  .prose :global(a) {
    font-weight: 700;
    color: var(--ink-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 15px;
    font-weight: 700;
    background: #f1f5f9;
    padding: 2px 8px;
    border-radius: 4px;
  }
  /* The app's identity (pink) and vault (blue) file colours, as ink for contrast */
  .prose :global(code.k1) {
    color: var(--ink-pink);
  }
  .prose :global(code.k2) {
    color: var(--ink-blue);
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }
  .prose :global(figcaption) {
    margin-top: 8px;
    font-size: 15px;
    color: #475569;
  }

  @media (prefers-color-scheme: dark) {
    .prose {
      background: #1e2732;
      border-color: #38444d;
      color: #cbd5e1;
    }
    .prose :global(:is(h2, h3, strong)) {
      color: #fff;
    }
    .prose :global(code) {
      background: #15202b;
    }
    .prose :global(figcaption) {
      color: #94a3b8;
    }
  }
  /* At 320px (iPhone Display Zoom) the longest words in the privacy policy and
     legal notices, such as "Microsoft-Unternehmensgruppe.", need a wider column */
  @media (max-width: 359px) {
    .prose {
      padding-inline: 12px;
    }
  }
  @media (min-width: 768px) {
    .prose {
      padding: 40px;
    }
  }
  .sheet-none {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
  }
  @media (max-width: 639px) {
    .sheet-wide {
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
    }
  }
  /* Without a card above it, the first block starts at the top */
  .prose > :global(:is(p, ul, ol, figure, blockquote, table):first-child) {
    margin-top: 0;
  }
</style>
