---
import { policyTitle } from "../data/privacy";
import { getPosts } from "../data/blog";
import { site } from "../data/site";
import { localePath, useStrings, type Language } from "../i18n";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const { t } = useStrings(lang.code);
const year = new Date().getFullYear();
// The blog link appears once there is a post to read. Posts are in English only, so
// other languages link to the English blog and say so.
const hasPosts = (await getPosts("en")).length > 0;
const blogLabel = lang.code === "en" ? t("nav.blog") : t("nav.blogEnglish");
const linkClass = "inline-flex min-h-11 items-center font-bold text-slate-700 hover:text-ink-blue dark:text-slate-200";
---

<footer class="mt-8 border-t-2 border-slate-200 bg-white dark:border-forge-border-dark dark:bg-forge-surface-dark">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 sm:px-6 lg:grid-cols-3">
    <div class="footer-links" data-nosnippet>
      <h2 class="text-[12px] font-extrabold tracking-widest text-slate-600 uppercase dark:text-slate-400">{t("footer.product")}</h2>
      <ul class="mt-2" role="list">
        <li><a class={linkClass} href={localePath(lang.code, "features/")}>{t("nav.features")}</a></li>
        <li><a class={linkClass} href={localePath(lang.code, "pricing/")}>{t("nav.pricing")}</a></li>
        <li><a class={linkClass} href={localePath(lang.code, "download/")}>{t("nav.download")}</a></li>
        <li><a class={linkClass} href={localePath(lang.code, "roadmap/")}>{t("nav.roadmap")}</a></li>
        {
          hasPosts && (
            <li>
              <a class={linkClass} href="/blog/" hreflang={lang.code === "en" ? undefined : "en"}>
                {blogLabel}
              </a>
            </li>
          )
        }
      </ul>
    </div>
    <div class="footer-links" data-nosnippet>
      <h2 class="text-[12px] font-extrabold tracking-widest text-slate-600 uppercase dark:text-slate-400">{t("footer.help")}</h2>
      <ul class="mt-2" role="list">
        <li><a class={linkClass} href={localePath(lang.code, "support/")}>{t("nav.support")}</a></li>
        <li><a class={linkClass} href={localePath(lang.code, "security/")}>{t("nav.security")}</a></li>
        <li><a class={linkClass} href={localePath(lang.code, "security/technical-details/")}>{t("technical.title")}</a></li>
        <li><a class={linkClass} href={localePath(lang.code, "privacy/")}>{policyTitle(lang.code)}</a></li>
        <li><a class={linkClass} href={localePath(lang.code, "press/")}>{t("nav.press")}</a></li>
        <li><a class={linkClass} href={localePath(lang.code, "legal/")}>{t("nav.legal")}</a></li>
      </ul>
    </div>
    <div class="text-[14px] leading-relaxed text-slate-600 sm:col-span-2 lg:col-span-1 dark:text-slate-300">
      <p class="font-bold">© {year} {site.name}</p>
    </div>
  </div>
</footer>
