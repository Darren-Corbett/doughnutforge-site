---
// One official store badge, linked to the store. Uses the page language's
// badge where an official one exists (src/assets/badges/<store>/<lang>.svg),
// otherwise English, marked as English (badgeArt in src/data/badges.ts). Badges
// are shown unaltered, all at the same height. The alt text is the badge's own
// wording (src/assets/badges/alt.json). The store opens in a new tab, and screen
// readers hear that after the badge's name.
//
// Content blockers hide badges in ways no one can predict, so two fallbacks
// follow it, hidden; StoreFallback.astro shows one only when the badge is not
// drawn:
// 1. A second badge: the same official file, byte for byte, served under a name
//    made from its content (/s/<hash>.svg), with an empty alt (the wording is
//    the link's text, for screen readers) and neutral names, so nothing in it
//    says "store" or "badge". It goes to the site's /go/<code>/<language>/
//    page, whose address names no store either, and which forwards to the store.
// 2. If that is hidden too, a plain link in the badge's own wording, to the same
//    /go/ page.
import { storeUrl, type PlatformId, type StoreId } from "../data/stores";
import { badgeArt, badgeWording, goPath, secondArt } from "../data/badges";
import { useStrings, type Language } from "../i18n";

interface Props {
  /** Marks the badge and its fallbacks with their platform */
  platform: PlatformId;
  store: StoreId;
  storeId: string;
  lang: Language;
}
const { platform, store, storeId, lang } = Astro.props;
const { t } = useStrings(lang.code);

const { alt, own } = badgeWording(store, lang.code);
const { file, image: badge } = badgeArt(store, lang.code);
const wordingLang = own ? undefined : "en";
const go = goPath(store, lang.path);

// 48px tall: above Apple's 40px minimum; a quarter of the height is kept clear around it.
const HEIGHT = 48;
const width = Math.round((badge.width / badge.height) * HEIGHT);
---

<a href={storeUrl(store, storeId, lang.hreflang)} class="inline-block shrink-0 p-3" target="_blank" rel="noopener noreferrer" data-platform={platform}>
  <img src={badge.src} width={width} height={HEIGHT} alt={alt} lang={wordingLang} loading="lazy" decoding="async" />
  <span class="sr-only">{t("a11y.newTab")}</span>
</a>
<p class="get-art" hidden data-get="art" data-platform={platform}>
  <a href={go} target="_blank" rel="noopener noreferrer">
    <img src={secondArt(file)} width={width} height={HEIGHT} alt="" loading="lazy" decoding="async" />
    <span class="sr-only"><span lang={wordingLang}>{alt}</span> {t("a11y.newTab")}</span>
  </a>
</p>
<p class="get-text" hidden data-get="text" data-platform={platform}>
  <a href={go} target="_blank" rel="noopener noreferrer"><span lang={wordingLang}>{alt}</span><span class="sr-only">{t("a11y.newTab")}</span></a>
</p>

<style>
  .get-art {
    flex-shrink: 0;
    padding: 12px;
  }
  .get-art a {
    display: block;
  }
  .get-art img {
    display: block;
  }
  .get-text {
    flex-basis: 100%;
    padding: 12px;
    font-size: 18px;
    font-weight: 700;
  }
  .get-text a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ink-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .get-art[hidden],
  .get-text[hidden] {
    display: none;
  }
</style>
