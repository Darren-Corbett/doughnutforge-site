---
// One official store badge, linked to the store. Uses the page language's
// badge where an official one exists (src/assets/badges/<store>/<lang>.svg),
// otherwise English, marked as English. A regional badge identical to its
// language's (en-US and en, es-MX and es at Microsoft) is not kept as a file of
// its own: the language's file is used, with the regional alt text. Identical
// SVGs would make the build's file names, and so the build ID, change by chance. Badges are shown unaltered, all at the
// same height. The alt text is the badge's own wording (src/assets/badges/alt.json).
// The store opens in a new tab, and screen readers hear that after the badge's name.
import type { ImageMetadata } from "astro";
import { storeUrl, type StoreId } from "../data/stores";
import alts from "../assets/badges/alt.json";
import { useStrings, type Language } from "../i18n";

interface Props {
  store: StoreId;
  storeId: string;
  lang: Language;
}
const { store, storeId, lang } = Astro.props;
const { t } = useStrings(lang.code);

const badges = import.meta.glob<{ default: ImageMetadata }>("../assets/badges/*/*.svg", { eager: true });
const altText: Record<string, string> = alts[store];
const base = lang.code.split("-")[0];
const own = badges[`../assets/badges/${store}/${lang.code}.svg`] ?? (altText[lang.code] ? badges[`../assets/badges/${store}/${base}.svg`] : undefined);
const badge = (own ?? badges[`../assets/badges/${store}/en.svg`])?.default;
if (!badge) throw new Error(`No badge for ${store}: add src/assets/badges/${store}/en.svg`);
const alt = own ? altText[lang.code] : altText.en;
if (!alt) throw new Error(`No alt text for ${store}/${own ? lang.code : "en"}.svg in src/assets/badges/alt.json`);

// 48px tall: above Apple's 40px minimum; a quarter of the height is kept clear around it.
const HEIGHT = 48;
const width = Math.round((badge.width / badge.height) * HEIGHT);
---

<a href={storeUrl(store, storeId, lang.hreflang)} class="inline-block shrink-0 p-3" target="_blank" rel="noopener noreferrer">
  <img src={badge.src} width={width} height={HEIGHT} alt={alt} lang={own ? undefined : "en"} loading="lazy" decoding="async" />
  <span class="sr-only">{t("a11y.newTab")}</span>
</a>
