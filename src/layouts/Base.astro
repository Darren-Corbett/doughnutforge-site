---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SEO from "../components/SEO.astro";
import { alternatesFor } from "../i18n/alternates";
import { isReviewed, splitPath, translatedPages, useStrings, type Language } from "../i18n";

interface Props {
  lang: Language;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Social preview image, from public/og/ */
  image?: string;
  /** Set on blog posts */
  article?: { published: Date; modified?: Date };
  /** Link the blog's RSS feed in <head> */
  feed?: boolean;
}
const { lang, title, description, jsonLd, noindex, image, article, feed } = Astro.props;
const { t } = useStrings(lang.code);

// A draft translation is built and reachable from the language switcher, but not
// indexed until src/i18n/review.json marks the language reviewed.
const { page } = splitPath(Astro.url.pathname);
const indexable = !noindex && isReviewed(lang.code);
const alternates = indexable && translatedPages.includes(page) ? alternatesFor(lang.code, page) : [];

// Social preview images: English ones are committed in public/og/. Other languages
// get their own (public/og/<language>/<page>.png) only in a build with
// OG_IMAGES=all, which also makes them (scripts/make-og.mjs); otherwise English.
const englishImage = image ?? "/og/default.png";
const ogImage =
  lang.code !== "en" && process.env.OG_IMAGES === "all" && /^\/og\/[^/]+\.png$/.test(englishImage)
    ? englishImage.replace(/^\/og\//, `/og/${lang.path}/`)
    : englishImage;
---

<!doctype html>
<html lang={lang.hreflang} dir={lang.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#1da1f2" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <SEO
      title={title}
      description={description}
      lang={lang.hreflang}
      jsonLd={jsonLd}
      noindex={!indexable}
      alternates={alternates}
      image={ogImage}
      article={article}
      feed={feed}
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only rounded-full bg-white px-5 py-3 font-extrabold text-ink-blue focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-50 dark:bg-forge-surface-dark"
    >
      {t("skip")}
    </a>
    <Header lang={lang} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
