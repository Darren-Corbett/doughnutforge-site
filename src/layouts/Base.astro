---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SEO from "../components/SEO.astro";
import { useStrings, type Language } from "../i18n";

interface Props {
  lang: Language;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { lang, title, description, jsonLd, noindex } = Astro.props;
const { t } = useStrings(lang.code);
---

<!doctype html>
<html lang={lang.code} dir={lang.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#1da1f2" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <SEO title={title} description={description} lang={lang.hreflang} jsonLd={jsonLd} noindex={noindex} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only rounded-full bg-white px-5 py-3 font-extrabold text-ink-blue focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-50 dark:bg-forge-surface-dark"
    >
      {t("skip")}
    </a>
    <Header lang={lang} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
