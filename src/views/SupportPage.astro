---
// Support: how to ask on GitHub (public, needs an account), the policy's own
// words on privacy questions, and the FAQ with matching FAQPage structured data.
// Visitors' browsers never call GitHub: these are plain links.
import Faq, { type FaqItem } from "../components/Faq.astro";
import PageHero from "../components/PageHero.astro";
import { issueLists, shownLists } from "../data/issues";
import { getPolicy, policyTitle } from "../data/privacy";
import { site } from "../data/site";
import { platformName, platforms } from "../data/stores";
import { fill, listOf, localePath, useStrings, type Language, type UiKey } from "../i18n";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const { t } = useStrings(lang.code);
const { html: policy } = getPolicy(lang.code);

const names = (status: "available" | "coming") =>
  listOf(
    lang,
    platforms.filter((p) => p.status === status).map((p) => platformName(lang, p.id)),
  );
const ids = ["subscription", "platforms", "offline", "storage", "backup", "restore", "share", "recipient", "messaging", "which", "data", "quantum"] as const;
const items: FaqItem[] = ids.map((id) => ({
  id,
  q: t(`faq.${id}.q` as UiKey),
  a: id === "which" ? fill(t("faq.which.a"), { available: names("available"), coming: names("coming") }) : t(`faq.${id}.a` as UiKey),
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang.hreflang,
  mainEntity: items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
};
---

<Base lang={lang} title={t("meta.support.title")} description={t("meta.support.description")} image="/og/support.png" jsonLd={jsonLd}>
  <PageHero title={t("support.title")} lead={t("support.lead")} />

  <section class="section" aria-labelledby="support-ask">
    <h2 id="support-ask" class="section-title">{t("support.ask.title")}</h2>
    <p class="section-text">{t("support.ask.text")}</p>
    <p class="warning"><strong>{t("support.ask.warning")}</strong></p>
    <div class="actions">
      <a class="btn-primary" href={site.issueFormUrl("bug_report")}>{t("support.ask.bug")}</a>
      <a class="btn-primary" href={site.issueFormUrl("question")}>{t("support.ask.question")}</a>
      <a class="btn-primary" href={site.issueFormUrl("feature_idea")}>{t("support.ask.idea")}</a>
      <a class="btn-outline" href={site.issuesUrl}>{t("support.ask.search")}</a>
    </div>
    <p class="section-text">
      {t("support.ask.security")} <a class="text-link" href={localePath(lang.code, "security/#report")}>{t("support.ask.securityLink")}</a>
    </p>
    {
      shownLists.length > 0 && (
        <ul class="answers" role="list">
          {shownLists.map((list) => (
            <li>
              <a class="text-link" href={localePath(lang.code, issueLists[list].path)}>
                {t(`${list}.title` as UiKey)}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section id="faq" class="section faq-section" aria-labelledby="support-faq">
    <h2 id="support-faq" class="section-title">{t("support.faq.title")}</h2>
    <Faq items={items} />
    <p class="section-text">
      <a class="text-link" href={localePath(lang.code, "security/technical-details/")}>{t("technical.link")}</a>
    </p>
  </section>

  <section class="section privacy" aria-labelledby="support-privacy">
    <h2 id="support-privacy" class="section-title">{t("support.privacy.title")}</h2>
    <p class="section-text policy-text" data-policy="sec3Desc" set:html={policy("sec3Desc")} />
    <p class="section-text">
      <a class="text-link" href={localePath(lang.code, "privacy/")}>{policyTitle(lang.code)}</a>
    </p>
  </section>
</Base>

<style>
  .warning {
    margin-top: 20px;
    max-width: 38rem;
    padding: 16px 18px;
    border-radius: 16px;
    border: 2px solid #f91880;
    background: rgb(249 24 128 / 0.08);
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-pink);
  }
  .actions {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  /* Answered questions and Known issues, once there are some */
  .answers {
    margin-top: 16px;
    font-size: 18px;
    line-height: 1.55;
  }
  .answers li + li {
    margin-top: 8px;
  }
  .faq-section,
  .privacy {
    padding-top: 0;
  }
  .policy-text :global(a),
  .text-link {
    font-weight: 700;
    color: var(--ink-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
