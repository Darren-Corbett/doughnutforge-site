---
// The privacy policy, word for word from src/content/legal/privacy/. Every element
// carries data-policy="<key>" so scripts/check-privacy-wording.mjs can compare it with the source.
import PageHero from "../components/PageHero.astro";
import Prose from "../components/Prose.astro";
import { getPolicy, policyTitle, type PolicyKey } from "../data/privacy";
import { site } from "../data/site";
import { useStrings, type Language } from "../i18n";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const { t } = useStrings(lang.code);
const { html } = getPolicy(lang.code);
// Sections 1 to 5 are one paragraph each; section 6, the website, has several
const sections: { title: PolicyKey; texts: PolicyKey[] }[] = [
  ...[1, 2, 3, 4, 5].map((n) => ({ title: `sec${n}Title` as PolicyKey, texts: [`sec${n}Desc` as PolicyKey] })),
  {
    title: "sec6Title",
    texts: ["sec6Counts", "sec6Never", "sec6Device", "sec6Processor", "sec6Basis", "sec6OptOut", "sec6Public", "sec6Hosting"],
  },
];
---

<Base lang={lang} title={`${policyTitle(lang.code)} | ${site.name}`} description={t("meta.privacy.description")} image="/og/privacy.png">
  <PageHero title={html("title")} lead={html("effectiveDate")} policyKeys={{ title: "title", lead: "effectiveDate" }} html />
  <div class="section">
    <Prose sheet="wide">
      <p data-policy="hero" set:html={html("hero")} />
      {
        sections.map((s) => (
          <>
            <h2 data-policy={s.title} set:html={html(s.title)} />
            {s.texts.map((text) => (
              <p data-policy={text} set:html={html(text)} />
            ))}
          </>
        ))
      }
      <p class="publisher" data-policy="publisherInfo" set:html={html("publisherInfo")} />
    </Prose>
  </div>
</Base>

<style>
  /* Muted slate on the white sheet; on phones the sheet is dropped, and on the page
     it would fall under 4.5:1, so it takes Secondary there */
  .publisher {
    margin-top: 32px;
    font-size: 14px;
    color: #64748b;
  }
  @media (max-width: 639px) {
    .publisher {
      color: #475569;
    }
  }
  @media (prefers-color-scheme: dark) {
    .publisher {
      color: #94a3b8;
    }
  }
</style>
