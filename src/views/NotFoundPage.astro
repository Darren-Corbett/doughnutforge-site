---
// 404: GitHub Pages serves dist/404.html for any address that does not exist.
// The app icon as a padlock, and the heading scrambled once like ciphertext. The
// scramble is an aria-hidden overlay, so the h1 is always the real text; without
// JavaScript or with reduced motion there is none.
import PageHero from "../components/PageHero.astro";
import { localePath, useStrings, type Language } from "../i18n";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const { t } = useStrings(lang.code);
const links = [
  { href: localePath(lang.code), label: t("nav.home") },
  { href: localePath(lang.code, "features/"), label: t("nav.features") },
  { href: localePath(lang.code, "download/"), label: t("nav.download") },
  { href: localePath(lang.code, "support/"), label: t("nav.support") },
];
---

<Base lang={lang} title={t("meta.notFound.title")} description={t("notFound.lead")} noindex>
  <PageHero title={t("notFound.title")} lead={t("notFound.lead")}>
    <svg class="lock-icon" viewBox="0 -8 120 158" width="96" height="126" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="nf-steel" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#f8fafc" /><stop offset=".55" stop-color="#94a3b8" /><stop offset="1" stop-color="#e2e8f0" />
        </linearGradient>
        <linearGradient id="nf-blue" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#3d9bff" /><stop offset="1" stop-color="#1468f0" />
        </linearGradient>
      </defs>
      <path class="shackle" d="M32 64V42a28 28 0 0 1 56 0v22" fill="none" stroke="url(#nf-steel)" stroke-width="11" stroke-linecap="round" />
      <rect x="4" y="50" width="112" height="98" rx="26" fill="url(#nf-blue)" />
      <circle cx="60" cy="99" r="29" fill="none" stroke="url(#nf-steel)" stroke-width="21" />
      <circle cx="60" cy="99" r="29" fill="none" stroke="#fff" stroke-opacity=".35" stroke-width="2" />
      <g stroke="#64748b" stroke-width="3" stroke-linecap="round">
        <path d="M44 80l5 3M70 77l5-2M80 96l1 5M73 118l4 2M43 116l-3 3M38 98l-1 5" />
      </g>
    </svg>
    <script is:inline>
      (() => {
        const title = document.getElementById("page-title");
        if (!title || !window.requestAnimationFrame || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const text = title.textContent.trim();
        const glyphs = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=";
        const overlay = document.createElement("span");
        overlay.setAttribute("data-scramble", "");
        overlay.setAttribute("aria-hidden", "true");
        title.classList.add("scrambling");
        title.append(overlay);
        const start = performance.now();
        let drawn = -Infinity;
        // Settles left to right over 2.4 seconds, keeping the spaces so lines wrap alike.
        // New letters about 14 times a second, slow enough to see them change.
        const frame = (now) => {
          const done = Math.min(1, (now - start) / 2400);
          if (done < 1 && now - drawn < 70) return requestAnimationFrame(frame);
          drawn = now;
          const settled = Math.floor(done * text.length);
          let shown = text.slice(0, settled);
          for (const c of text.slice(settled)) shown += c === " " ? c : glyphs[Math.floor(Math.random() * glyphs.length)];
          overlay.textContent = shown;
          if (done < 1) return requestAnimationFrame(frame);
          overlay.remove();
          title.classList.remove("scrambling");
        };
        frame(start);
      })();
    </script>
  </PageHero>
  <section class="section" aria-label={t("notFound.try")}>
    <p class="section-text">{t("notFound.try")}</p>
    <ul class="links" role="list">
      {
        links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .lock-icon {
    margin-top: 8px;
  }
  /* The shackle starts open and clicks shut once, as the heading settles */
  @media (prefers-reduced-motion: no-preference) {
    .shackle {
      animation: shut 0.3s cubic-bezier(0.5, 0, 0.75, 0) 2.2s both;
    }
  }
  @keyframes shut {
    from {
      transform: translateY(-12px);
    }
    to {
      transform: translateY(0);
    }
  }
  /* The heading belongs to PageHero and the overlay is made by the script, hence :global */
  :global(#page-title.scrambling) {
    position: relative;
    color: transparent;
  }
  :global([data-scramble]) {
    position: absolute;
    inset: 0;
    color: #fff;
  }
  .links {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .links a {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    padding: 10px 22px;
    border-radius: 9999px;
    border: 2px solid #cbd5e1;
    font-size: 17px;
    font-weight: 800;
  }
  @media (prefers-color-scheme: dark) {
    .links a {
      border-color: #38444d;
    }
  }
</style>
