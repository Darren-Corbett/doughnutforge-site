---
// Security: how Doughnut Forge protects files, in what a user needs to know and
// no more, that no outside audit has happened yet, and how to report a problem
// privately (GitHub's private vulnerability reporting, never the public issues).
// The facts come first, as rows like the home features; the reporting section is
// for security researchers, so it comes last and stays quiet.
import PageHero from "../components/PageHero.astro";
import ToneRows, { type ToneRow } from "../components/ToneRows.astro";
import { site } from "../data/site";
import { localePath, useStrings, type Language, type UiKey } from "../i18n";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const { t } = useStrings(lang.code);
// Blue only: the other tab tones label the app's features, and these are not features.
// The missing audit is a row of its own, as loud as the facts.
const facts: ToneRow[] = [
  ...(["device", "servers", "quantum", "keys"] as const).map((id) => ({
    name: t(`security.${id}.title` as UiKey),
    tone: "blue" as const,
    text: t(`security.${id}.text` as UiKey),
  })),
  {
    name: t("security.audit.title"),
    tone: "blue",
    text: t("security.audit.text"),
    link: { href: localePath(lang.code, "roadmap/"), label: t("security.audit.link") },
  },
];
---

<Base lang={lang} title={t("meta.security.title")} description={t("meta.security.description")} image="/og/security.png">
  <PageHero title={t("security.title")} lead={t("security.lead")} />
  <div class="section">
    <ToneRows rows={facts} />
    <div class="technical ruled-row-late">
      <h2>{t("technical.title")}</h2>
      <div>
        <p>{t("security.technical.text")}</p>
        <a class="btn-outline" href={localePath(lang.code, "security/technical-details/")}>{t("security.technical.button")}</a>
      </div>
    </div>
  </div>

  <section class="section report-section" aria-labelledby="report">
    <div class="report ruled-row-late">
      <h2 id="report">{t("security.report.title")}</h2>
      <div>
        <p>{t("security.report.text")}</p>
        <p>{t("security.report.private")}</p>
        <p>{t("security.report.promise")}</p>
        <a class="btn-outline" href={site.reportUrl} target="_blank" rel="noopener noreferrer">
          {t("security.report.button")}
          <span class="sr-only">{t("a11y.newTab")}</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The technical details and the report line up with the rows: heading, then text,
     side by side from 1024px (.ruled-row-late in global.css), without a rule */
  .technical,
  .report {
    display: grid;
    gap: 6px 32px;
  }
  .technical {
    margin-top: 32px;
  }
  h2 {
    --fs: 19px;
    line-height: 1.3;
    font-weight: 800;
    color: #0f172a;
  }
  p {
    font-size: 17px;
    line-height: 1.55;
    max-width: 38rem;
    color: #475569;
  }
  p + p {
    margin-top: 10px;
  }
  .btn-outline {
    margin-top: 20px;
  }

  /* For security researchers: set apart in a plain card, after everything else */
  .report-section {
    padding-top: 0;
  }
  .report {
    padding: 20px 20px 22px;
    border-radius: 20px;
    border: 2px solid #e2e8f0;
    background: #fff;
  }
  /* A card name, as on the platform cards */
  .report h2 {
    --fs: 24px;
    font-weight: 900;
  }

  @media (prefers-color-scheme: dark) {
    h2 {
      color: #fff;
    }
    p {
      color: #cbd5e1;
    }
    .report {
      background: #1e2732;
      border-color: #38444d;
    }
  }

</style>
