---
// Home page. Shows encryption instead of describing it: the same note as a
// stranger sees it and as your contact sees it. Phones lead because the iPhone
// app is the face of the product; Mac and Windows are on sale today.
import iphoneIdentity from "../assets/app/iphone-identity.webp";
import iphoneFile from "../assets/app/iphone-secure-file.webp";
import iphoneText from "../assets/app/iphone-secure-text.webp";
import Ciphertext from "../components/Ciphertext.astro";
import Phone from "../components/Phone.astro";
import StoreLinks from "../components/StoreLinks.astro";
import ToneRows, { type ToneRow } from "../components/ToneRows.astro";
import { organization, softwareApplication } from "../data/jsonld";
import { useStrings, type Language } from "../i18n";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const { t, app, store } = useStrings(lang.code);

// Feature titles and text come from the Mac store listing, so they match the
// store wording and are already translated. Row names are the app's own tab names.
const [encFiles, encText, identity, share, longTerm, language] = store.mac.features;
if (!encFiles || !encText || !identity || !share || !longTerm || !language) {
  throw new Error(`The store listing has ${store.mac.features.length} features; the home page expects 6.`);
}
// The headline is the store description's first sentence (split per language by
// scripts/sync-from-app.mjs). The lead is the site's own: the Mac listing's says
// "on your computer", and the app is on phones and tablets too.
const { headline } = store.mac.parts;
const lead = t("home.lead");

const rows: ToneRow[] = [
  { name: app("app:navigation.tabs.vault"), tone: "blue", ...encFiles },
  { name: app("app:navigation.tabs.text-vault"), tone: "orange", ...encText },
  { name: app("app:navigation.tabs.identity"), tone: "violet", ...identity },
  { name: app("app:navigation.tabs.contacts"), tone: "pink", ...share },
];

const jsonLd = [softwareApplication(lang, "/", t("meta.home.description")), organization()];
---

<Base lang={lang} title={t("meta.home.title")} description={t("meta.home.description")} jsonLd={jsonLd} appBanner>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-inner">
      <div class="hero-copy">
        <h1 id="home-title">{headline}</h1>
        <p class="summary">{t("home.summary")}</p>
        <p class="tagline">{t("home.tagline")}</p>
        <p class="lead">{lead}</p>
        <div class="actions" data-nosnippet>
          <a class="btn-primary" href="#download">{t("home.cta.primary")}</a>
          <a class="btn-quiet" href="#features">{t("home.cta.secondary")}</a>
        </div>
      </div>

      <div class="specimen">
        <figure class="pane pane-stranger">
          <figcaption><span class="dot dot-blue" aria-hidden="true"></span>{t("home.specimen.stranger")}</figcaption>
          <div class="stack">
            <p class="layer layer-plain" aria-hidden="true">{t("home.specimen.note")}</p>
            <Ciphertext class="layer layer-cipher" length={150} label={t("home.specimen.cipherLabel")} />
            <span class="scan" aria-hidden="true"></span>
          </div>
        </figure>
        <figure class="pane pane-contact">
          <figcaption><span class="dot dot-green" aria-hidden="true"></span>{t("home.specimen.contact")}</figcaption>
          <p class="note">{t("home.specimen.note")}</p>
        </figure>
        <p class="caption">{t("home.specimen.caption")}</p>
      </div>
    </div>
  </section>

  <section class="section what" aria-labelledby="home-what">
    <h2 id="home-what" class="section-title">{t("home.what.title")}</h2>
    <p class="section-text">{t("home.what.text")}</p>
  </section>

  <section class="phones" aria-labelledby="home-phones">
    <div class="phones-inner">
      <h2 id="home-phones">{t("home.phones.title")}</h2>
      <p>{t("home.phones.text")}</p>
      <ul class="phone-row" role="list">
        <li><Phone src={iphoneText} sizes="(min-width: 768px) 240px, 46vw" alt={t("home.phones.altText")} /></li>
        <li><Phone src={iphoneFile} sizes="(min-width: 768px) 240px, 46vw" alt={t("home.phones.altFile")} /></li>
        <li class="third"><Phone src={iphoneIdentity} sizes="240px" alt={t("home.phones.altIdentity")} /></li>
      </ul>
    </div>
  </section>

  <section id="features" class="section" aria-labelledby="home-features">
    <h2 id="home-features" class="section-title">{t("home.features.title")}</h2>
    <ToneRows rows={rows} />
    <div class="extras">
      <div>
        <h3>{longTerm.title}</h3>
        <p>{longTerm.text}</p>
      </div>
      <div>
        <h3>{language.title}</h3>
        <p>{language.text}</p>
      </div>
    </div>
  </section>

  <section id="download" class="section" aria-labelledby="pricing">
    <h2 id="pricing" class="section-title">{t("home.pricing.title")}</h2>
    <p class="download-lead">{t("home.pricing.text")}</p>
    <p class="statement bill">{store.mac.closing}</p>
    <StoreLinks lang={lang} />
  </section>
</Base>

<style>
  /* Night hero in both themes: the app's dark surfaces, its blue and green inks. */
  .hero {
    --night: #15202b;
    --panel: #1e2732;
    --line: #38444d;
    background: var(--night);
    color: #fff;
  }
  .hero-inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: 40px 16px 48px;
    display: grid;
    gap: 36px;
  }
  h1 {
    --fs: clamp(38px, 10.5vw, 76px);
    line-height: 1;
    font-weight: 900;
    letter-spacing: -0.03em;
    max-width: 12ch;
  }
  .summary {
    margin-top: 16px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 1.55;
    font-weight: 700;
    color: #cbd5e1;
  }
  /* Ink blue for dark backgrounds: 6.9:1 on the night colour */
  .tagline {
    margin-top: 16px;
    max-width: 20ch;
    --fs: clamp(22px, 6vw, 30px);
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #4cb5f5;
  }
  .lead {
    margin-top: 16px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 1.55;
    color: #cbd5e1;
  }
  .actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  /* Long headline words are sized to fit this column (global.css) */
  .hero-copy {
    container-type: inline-size;
  }
  .specimen {
    position: relative;
  }
  .pane {
    border-radius: 20px;
    padding: 18px 20px 22px;
  }
  .pane figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 800;
    margin-bottom: 12px;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    flex: none;
  }
  .dot-blue {
    background: #1da1f2;
  }
  .dot-green {
    background: #00ba7c;
  }
  .pane-stranger {
    background: var(--panel);
    border: 2px solid var(--line);
    color: #4cb5f5;
  }
  .pane-contact {
    position: relative;
    margin-top: -14px;
    margin-inline-start: 8%;
    background: #fff;
    color: #14171a;
    border: 2px solid #00ba7c;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.45);
  }
  .note,
  .layer-plain {
    font-size: 17px;
    line-height: 1.5;
    font-weight: 600;
  }
  .stack {
    position: relative;
    display: grid;
  }
  .layer {
    grid-area: 1 / 1;
  }
  .layer-plain {
    color: #fff;
    animation: hide-plain 1.8s cubic-bezier(0.65, 0, 0.35, 1) 0.6s both;
  }
  /* The ciphertext element belongs to the Ciphertext component, so it is reached with :global */
  :global(.layer-cipher) {
    grid-area: 1 / 1;
    font-size: 15px;
    line-height: 1.5;
    animation: show-cipher 1.8s cubic-bezier(0.65, 0, 0.35, 1) 0.6s both;
  }
  .scan {
    position: absolute;
    top: -6px;
    bottom: -6px;
    width: 3px;
    border-radius: 3px;
    background: #1da1f2;
    box-shadow: 0 0 18px #1da1f2;
    animation: scan 1.8s cubic-bezier(0.65, 0, 0.35, 1) 0.6s both;
  }
  @keyframes show-cipher {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes hide-plain {
    from {
      clip-path: inset(0 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 100%);
    }
  }
  @keyframes scan {
    from {
      left: 0;
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    to {
      left: 100%;
      opacity: 0;
    }
  }
  .caption {
    margin-top: 14px;
    font-size: 14px;
    color: #94a3b8;
  }

  /* Phones continue the night band: the iPhone app is dark, so it sits naturally here */
  .phones {
    background: #15202b;
    color: #fff;
    border-top: 2px solid #38444d;
  }
  .phones-inner {
    container-type: inline-size;
    max-width: 72rem;
    margin-inline: auto;
    padding: 44px 16px 56px;
  }
  .phones h2 {
    --fs: clamp(26px, 7vw, 40px);
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: -0.02em;
  }
  .phones-inner > p {
    margin-top: 8px;
    font-size: 18px;
    color: #cbd5e1;
  }
  .phone-row {
    margin-top: 28px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: start;
  }
  /* The middle phone sits lower, so the row reads as a set rather than a grid */
  .phone-row li:nth-child(2) {
    margin-top: 40px;
  }
  .phone-row .third {
    display: none;
  }

  /* Features: the rows are ToneRows; these two sit under them */
  .extras h3 {
    --fs: 19px;
    font-weight: 800;
  }
  .extras p {
    margin-top: 4px;
    font-size: 17px;
    line-height: 1.55;
    max-width: 38rem;
    color: #475569;
  }
  .extras {
    display: grid;
    gap: 24px;
    margin-top: 12px;
    padding-top: 26px;
    border-top: 3px solid #00ba7c;
  }
  .download-lead {
    margin-top: 12px;
    font-size: 18px;
    font-weight: 700;
    max-width: 34rem;
  }
  /* The store listing's closing line (.statement) */
  .bill {
    margin-top: 20px;
    margin-bottom: 28px;
  }

  @media (prefers-color-scheme: dark) {
    .extras p {
      color: #cbd5e1;
    }
  }

  @media (min-width: 768px) {
    .hero-inner {
      padding: 72px 24px 80px;
    }
    .phones-inner {
      padding: 64px 24px 80px;
    }
    .phone-row {
      grid-template-columns: repeat(3, minmax(0, 240px));
      gap: 32px;
    }
    .phone-row .third {
      display: block;
    }
    .extras {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .hero-inner {
      grid-template-columns: 6fr 6fr;
      align-items: center;
      gap: 56px;
    }
  }
</style>
