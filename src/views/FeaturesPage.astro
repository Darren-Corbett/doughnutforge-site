---
// Features: the app's tabs in their tab colours, with the store listing's
// wording and plain sentences from the app's own guides, then what the iPhone
// and iPad app adds, and what Mac and Windows add. Screenshots are the v2 iPhone
// and iPad screens in the page's language (src/data/screens.ts).
import Faq, { type FaqItem } from "../components/Faq.astro";
import PageHero from "../components/PageHero.astro";
import Phone from "../components/Phone.astro";
import Tablet from "../components/Tablet.astro";
import ToneRows, { type ToneRow } from "../components/ToneRows.astro";
import { screen } from "../data/screens";
import { languages, localePath, useStrings, type Language, type UiKey } from "../i18n";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const { t, app, store } = useStrings(lang.code);

const [encFiles, encText, identity, share, longTerm, inLanguage] = store.mac.features;
if (!encFiles || !encText || !identity || !share || !longTerm || !inLanguage) {
  throw new Error(`The Mac store listing has ${store.mac.features.length} features; the features page expects 6.`);
}
// The site's own lead and offline paragraph, for phones, tablets and computers
const lead = t("features.lead");
const offline = t("offline.text");

const rows: ToneRow[] = [
  { name: t("tabs.files"), tone: "blue", ...encFiles, more: [app("help:secureDirectoryGuide.step1.description")] },
  { name: t("tabs.text"), tone: "orange", ...encText },
  { name: app("app:navigation.tabs.identity"), tone: "violet", ...identity, more: [t("features.identity.more")] },
  // No guide sentences here: the app's guides say a contact card verifies who someone is, which it does not
  { name: app("app:navigation.tabs.contacts"), tone: "pink", ...share },
];

// What only the iPhone and iPad app does: the iOS listing's photos and videos,
// opening what is sent to you, and Face ID and Touch ID (features 1, 2 and 6),
// then the v2 privacy screen (features.md: iPhone and iPad only)
if (store.ios.features.length !== 8) {
  throw new Error(`The iOS store listing has ${store.ios.features.length} features; the features page expects 8.`);
}
const iosFeatures = [...[0, 1, 5].map((i) => store.ios.features[i]!), { title: t("v2.privacy.title"), text: t("v2.privacy.text") }];

// The questions people ask first, answered as on the support page. Only the
// support page carries the FAQPage data, so the answers are marked up once.
const faq: FaqItem[] = ["offline", "storage", "restore", "subscription"].map((id) => ({
  id,
  q: t(`faq.${id}.q` as UiKey),
  a: t(`faq.${id}.a` as UiKey),
}));
---

<Base lang={lang} title={t("meta.features.title")} description={t("meta.features.description")} image="/og/features.png">
  <PageHero title={t("features.title")} tagline={t("home.tagline")} lead={lead}>
    <span class="cta-button" data-nosnippet><a class="btn-primary" href={localePath(lang.code, "download/")}>{t("button.getApp")}</a></span>
  </PageHero>

  <section class="section" aria-labelledby="features-tabs">
    <h2 id="features-tabs" class="section-title">{t("home.features.title")}</h2>
    <ToneRows rows={rows} />
  </section>

  <section class="section private" aria-labelledby="features-private">
    <h2 id="features-private" class="section-title">{t("features.private.title")}</h2>
    <div class="blocks">
      <div class="block tone-green">
        <h3>{t("features.offline.title")}</h3>
        <p>{offline}</p>
      </div>
      <div class="block tone-violet">
        <h3>{longTerm.title}</h3>
        <p>{longTerm.text}</p>
      </div>
      <div class="block tone-blue">
        <h3>{inLanguage.title}</h3>
        <p>{inLanguage.text}</p>
      </div>
    </div>
    <h3 class="languages-label">{t("features.languages.label")}</h3>
    <ul class="languages" role="list">
      {
        languages.map((l) => (
          <li lang={l.code} dir={l.dir}>
            {l.name}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="phones" aria-labelledby="features-ios">
    <div class="phones-inner">
      <h2 id="features-ios">{t("features.ios.title")}</h2>
      <p class="phones-text">{t("features.ios.text")}</p>
      <ul class="band-list ios-list" role="list">
        {
          iosFeatures.map((f) => (
            <li>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ul>
      <div class="shots">
        <div class="shot-phone">
          <Phone src={screen(lang.code, "iphone-progress-light")} sizes="(min-width: 768px) 220px, 44vw" alt={t("features.ios.altEncrypting")} />
        </div>
        <div class="shot-phone">
          <Phone src={screen(lang.code, "iphone-encrypt-light")} sizes="(min-width: 768px) 220px, 44vw" alt={t("features.ios.altChoose")} />
        </div>
        <div class="shot-tablet">
          <Tablet src={screen(lang.code, "ipad-files-light")} sizes="(min-width: 768px) 420px, 92vw" alt={t("features.ios.altIpad")} />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="features-desktop">
    <h2 id="features-desktop" class="section-title">{t("features.desktop.title")}</h2>
    <p class="section-text">{t("features.desktop.text")}</p>
  </section>

  <section class="section" aria-labelledby="features-faq">
    <h2 id="features-faq" class="section-title">{t("support.faq.title")}</h2>
    <Faq items={faq} />
    <p class="faq-more"><a href={`${localePath(lang.code, "support/")}#faq`}>{t("pricing.questionsLink")}</a></p>
  </section>

  <section class="section cta" aria-labelledby="features-cta">
    <h2 id="features-cta" class="section-title">{t("features.cta.title")}</h2>
    <p class="section-text">{t("home.pricing.title")} {t("home.phones.text")}</p>
    <p class="cta-actions">
      <span class="cta-button" data-nosnippet><a class="btn-primary" href={localePath(lang.code, "download/")}>{t("button.getApp")}</a></span>
    </p>
  </section>
</Base>

<style>
  /* A new group after the FAQ's last rule, and a link that looks like one */
  .faq-more {
    margin-top: 28px;
    font-size: 18px;
    font-weight: 700;
  }
  .faq-more a {
    color: var(--ink-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .private {
    padding-top: 0;
  }
  .blocks {
    display: grid;
    gap: 24px;
    margin-top: 28px;
  }
  .block {
    padding-top: 22px;
    border-top: 3px solid var(--tone);
  }
  .block h3 {
    --fs: 19px;
    font-weight: 800;
  }
  .block p {
    margin-top: 4px;
    font-size: 17px;
    line-height: 1.55;
    color: #475569;
  }
  .languages-label {
    margin-top: 36px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #475569;
  }
  .languages {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .languages li {
    padding: 6px 14px;
    border-radius: 9999px;
    border: 2px solid #cbd5e1;
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
  }

  /* The iPhone and iPad band continues the home page's night phones band */
  .phones {
    background: #15202b;
    color: #fff;
  }
  .phones-inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: 48px 16px 56px;
  }
  .phones h2 {
    --fs: clamp(26px, 7vw, 40px);
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: -0.02em;
  }
  .phones-text {
    margin-top: 8px;
    font-size: 18px;
    color: #cbd5e1;
  }
  .shots {
    margin-top: 36px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: start;
  }
  .shot-tablet {
    grid-column: 1 / -1;
  }
  .cta-actions {
    margin-top: 24px;
  }

  @media (prefers-color-scheme: dark) {
    .block p,
    .languages-label {
      color: #cbd5e1;
    }
    .languages li {
      border-color: #38444d;
    }
  }
  @media (min-width: 768px) {
    .phones-inner {
      padding: 64px 24px 80px;
    }
    .shots {
      grid-template-columns: 220px 220px minmax(0, 420px);
      gap: 32px;
      align-items: center;
    }
    .shot-tablet {
      grid-column: auto;
    }
  }
  /* Three columns only once each is wide enough for long words, such as the
     German "Post-Quanten-Verschlüsselung", which never break */
  @media (min-width: 1024px) {
    .blocks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }
  }
  /* Four items: two by two once there is room */
  @media (min-width: 768px) {
    .ios-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }
  }
</style>
