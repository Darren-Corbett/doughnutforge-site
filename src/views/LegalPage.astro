---
// Legal information: the trademark notices for the store names and badges on the site.
import PageHero from "../components/PageHero.astro";
import Prose from "../components/Prose.astro";
import { useStrings, type Language } from "../i18n";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const { t } = useStrings(lang.code);
---

<Base lang={lang} title={t("meta.legal.title")} description={t("meta.legal.description")} image="/og/legal.png">
  <PageHero title={t("legal.title")} />
  <div class="section">
    <Prose>
      <h2>{t("legal.trademarks.title")}</h2>
      <p>{t("legal.trademarks.apple")}</p>
      <p>{t("legal.trademarks.microsoft")}</p>
      <p>{t("legal.trademarks.other")}</p>
    </Prose>
  </div>
</Base>
