---
// The public roadmap: shipped, next and later (src/data/roadmap.ts). A section
// with no items is left out. Nothing carries a date; the Next and Later headings
// say an item is planned, so the items do not repeat it.
// Each group is a ruled row, like the home features: green for what is out now
// (DESIGN.md: green means yours and ready), blue for next, quiet grey for later.
// The group rule is the only rule: items are set apart by space, as in the rows.
import PageHero from "../components/PageHero.astro";
import { roadmap, roadmapStatuses } from "../data/roadmap";
import { useStrings, type Language, type UiKey } from "../i18n";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const { t } = useStrings(lang.code);
const tones = { shipped: "tone-green", next: "tone-blue", later: "tone-later" };
const sections = roadmapStatuses
  .map((status) => ({ status, items: roadmap.filter((i) => i.status === status) }))
  .filter((s) => s.items.length);
---

<Base lang={lang} title={t("meta.roadmap.title")} description={t("meta.roadmap.description")} image="/og/roadmap.png">
  <PageHero title={t("roadmap.title")} lead={t("roadmap.lead")} />
  <div class="section">
    {
      sections.map(({ status, items }) => (
        <section class:list={["group", tones[status]]} data-roadmap={status} aria-labelledby={`roadmap-${status}`}>
          <div class="group-head">
            <h2 id={`roadmap-${status}`}>{t(`roadmap.${status}` as UiKey)}</h2>
          </div>
          <ul class="items" role="list">
            {items.map((item) => (
              <li>
                <h3>{t(item.title)}</h3>
                {item.text && <p>{t(item.text)}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .tone-later {
    --tone: #cbd5e1;
    --ink: #475569;
  }
  .group {
    display: grid;
    gap: 6px 32px;
    padding: 22px 0 26px;
    border-top: 3px solid var(--tone);
  }
  /* The name fits its own column, so a long word shrinks rather than push the items off the page */
  .group-head {
    container-type: inline-size;
  }
  h2 {
    --fs: clamp(26px, 7vw, 36px);
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  li + li {
    margin-top: 28px;
  }
  h3 {
    --fs: 19px;
    line-height: 1.3;
    font-weight: 800;
    color: #0f172a;
  }
  p {
    margin-top: 4px;
    max-width: 38rem;
    font-size: 17px;
    line-height: 1.55;
    color: #475569;
  }
  @media (prefers-color-scheme: dark) {
    .tone-later {
      --tone: #38444d;
      --ink: #cbd5e1;
    }
    h3 {
      color: #fff;
    }
    p {
      color: #cbd5e1;
    }
  }
  @media (min-width: 768px) {
    .group {
      grid-template-columns: 5fr 7fr;
      align-items: baseline;
    }
  }
</style>
