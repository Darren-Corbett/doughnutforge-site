---
// The public roadmap: shipped, next and later (src/data/roadmap.ts). A section
// with no items is left out. Nothing carries a date; the Next and Later headings
// say an item is planned, so the items do not repeat it.
// Each group is a ruled row, like the home features: green for what is out now
// (DESIGN.md: green means yours and ready), blue for next, quiet grey for later.
// The group rule is the only rule: items are set apart by space, as in the rows.
import PageHero from "../components/PageHero.astro";
import { roadmap, roadmapStatuses } from "../data/roadmap";
import { useStrings, type Language, type UiKey } from "../i18n";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const { t } = useStrings(lang.code);
const tones = { shipped: "tone-green", next: "tone-blue", later: "tone-quiet" };
const sections = roadmapStatuses
  .map((status) => ({ status, items: roadmap.filter((i) => i.status === status) }))
  .filter((s) => s.items.length);
---

<Base lang={lang} title={t("meta.roadmap.title")} description={t("meta.roadmap.description")} image="/og/roadmap.png">
  <PageHero title={t("roadmap.title")} lead={t("roadmap.lead")} />
  <div class="section">
    {
      sections.map(({ status, items }) => (
        <section class:list={["ruled-row", tones[status]]} data-roadmap={status} aria-labelledby={`roadmap-${status}`}>
          <div class="ruled-row-head">
            <h2 id={`roadmap-${status}`} class="row-name">{t(`roadmap.${status}` as UiKey)}</h2>
          </div>
          <ul class="items" role="list">
            {items.map((item) => (
              <li>
                <h3>{t(item.title)}</h3>
                {item.text && <p>{t(item.text)}</p>}
                {item.points && (
                  <ul class="points">
                    {item.points.map((point) => (
                      <li>{t(point)}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .items > li + li {
    margin-top: 28px;
  }
  /* Doughnut Forge 2's highlights: a plain bulleted list under its text */
  .points {
    margin-top: 12px;
    max-width: 38rem;
    padding-inline-start: 1.25em;
    list-style: disc;
    font-size: 17px;
    line-height: 1.55;
  }
  .points li + li {
    margin-top: 6px;
  }
  h3 {
    --fs: 19px;
    line-height: 1.3;
    font-weight: 800;
    color: #0f172a;
  }
  p {
    margin-top: 4px;
    max-width: 38rem;
    font-size: 17px;
    line-height: 1.55;
    color: #475569;
  }
  .points {
    color: #475569;
  }
  @media (prefers-color-scheme: dark) {
    h3 {
      color: #fff;
    }
    p,
    .points {
      color: #cbd5e1;
    }
  }
</style>
